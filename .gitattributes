# Shipped executables must stay LF. A CRLF checkout turns the shebang into
# `bash\r`, and every later Unix checkout dies with "bad interpreter" — on the
# exact file a user copies to turn the router on.
*.sh              text eol=lf
*.py              text eol=lf
optional/inject-router text eol=lf

# Markdown is hand-wrapped; keep it byte-stable across platforms.
*.md              text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.json            text eol=lf
