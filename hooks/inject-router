#!/usr/bin/env bash
# Inject the router skill into every session as additional context.
#
# On by default, which is a deliberate reversal. Measured: given realistic
# prompts in a session with a full tool set, the pack's skills frequently did
# not load at all and nothing else loaded either — the model simply began
# working. An injection nobody asked for costs every session a fixed amount of
# context; a discipline that never enters view costs the change it would have
# governed. See the router section of the README for how to turn it off.
#
# Degrades to silence rather than breaking a session: no python3, no router
# file, or any read failure exits 0 with no output.
set -uo pipefail

root="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
router="$root/skills/using-ledger/SKILL.md"

command -v python3 >/dev/null 2>&1 || exit 0
[ -r "$router" ] || exit 0

python3 - "$router" <<'PY' || exit 0
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        body = handle.read()
except OSError:
    raise SystemExit(0)

preamble = (
    "The full content of the ledger router skill follows. It names every skill "
    "in the pack and when to reach for each. Load the individual skills through "
    "the Skill tool as their descriptions match the work.\n\n"
)
print(json.dumps({
    "hookSpecificOutput": {
        "hookEventName": "SessionStart",
        "additionalContext": preamble + body,
    }
}))
PY
